          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]bareclip.exe&quot; --play &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\BareClip\Capabilities" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="ApplicationName" Type="string" Value="BareClip" />
          <RegistryValue Name="ApplicationDescription" Type="string" Value="Plays, trims and edits videos and sound." />
          <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]bareclip.exe,0" />
