          <RegistryValue Key="FileAssociations" Name=".wmv" Type="string" Value="BareClip.Video" />
          <RegistryValue Key="FileAssociations" Name=".flv" Type="string" Value="BareClip.Video" />
          <RegistryValue Key="FileAssociations" Name=".3gp" Type="string" Value="BareClip.Video" />
          <RegistryValue Key="FileAssociations" Name=".mts" Type="string" Value="BareClip.Video" />
          <RegistryValue Key="FileAssociations" Name=".m2ts" Type="string" Value="BareClip.Video" />
