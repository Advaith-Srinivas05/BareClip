      <!-- BareClip as a player for every video and sound it plays: a file type of its own for
           each, listed under Default apps and in each type's Open with list. Nothing changes
           which program a type opens with, which Windows leaves to the person. -->
      <Component Id="PlayerTypes" Guid="3E7A51C9-8D24-4F06-B1E3-6C92A0D4F7B8">
        <RegistryValue Root="HKMU" Key="Software\BareClip" Name="PlayerTypes" Type="integer" Value="1" KeyPath="yes" />
        <RegistryKey Root="HKMU" Key="Software\Classes\BareClip.Video" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="BareClip video" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="BareClip video" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="[INSTALLFOLDER]bareclip.exe,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]bareclip.exe&quot; --play &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\BareClip.Audio" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="BareClip audio" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="BareClip audio" />
