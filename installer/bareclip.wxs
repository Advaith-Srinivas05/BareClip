        </RegistryKey>
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="BareClip" Type="string" Value="Software\BareClip\Capabilities" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp4\OpenWithProgids" Name="BareClip.Video" Type="string" Value="" />
